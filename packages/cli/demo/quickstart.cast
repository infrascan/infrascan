[7.250966, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[34m?\u001b[39m \u001b[1mWhich profile should be used?\u001b[22m\r\r\n  default\r\r\n\u001b[36m❯ production\u001b[39m\r\r\n  staging\r\r\n\r\r\n\u001b[36mDefault region: us-east-1\u001b[39m\r\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
