[3.806834, "o", "\u001b[34m?\u001b[39m \u001b[1mWhere should infrascan load AWS credentials from?\u001b[22m\r\r\n\u001b[2m- Environment variables (not set)\u001b[22m\r\r\n\u001b[36m❯ Profile from AWS config files\u001b[39m\r\r\n  Assume an IAM role\r\r\n  Default credential provider chain\r\r\n\r\r\n\u001b[36mUses a profile from ~/.aws/config or ~/.aws/credentials (including SSO profiles).\u001b[39m\r\r\n\u001b[1m↑↓\u001b[22m \u001b[2mnavigate\u001b[22m\u001b[2m • \u001b[22m\u001b[1m⏎\u001b[22m \u001b[2mselect\u001b[22m\u001b[?25l\u001b[23G"]
[5.629715, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G\u001b[32m✔\u001b[39m \u001b[1mWhere should infrascan load AWS credentials from?\u001b[22m \u001b[36mProfile from AWS config files\u001b[39m\u001b[82G"]
